{
  "$schema": "https://turbo.build/schema.v2.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["dashboard#build"],
      "inputs": ["cmd/**", "internal/**", "migrations/**", "go.mod", "go.sum"],
      "outputs": ["bin/**"],
      "env": ["CGO_ENABLED", "GOOS", "GOARCH"]
    },
    "test": {
      "inputs": ["**/*.go", "go.mod"],
      "outputs": []
    }
  }
}
