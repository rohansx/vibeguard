# Database
DB_PASSWORD=change-me-in-production

# Clerk Authentication (optional for local-only mode, required for team sync)
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...

# Anthropic API — Claude Sonnet for hybrid sanitizer classification (Phase 2, optional in Phase 1)
ANTHROPIC_API_KEY=sk-ant-...

# SPG store path — where the local Security Property Graph is persisted on disk
# Default: ~/.vibeguard/graph (set this to override)
# SPG_STORE_PATH=

# Team sync (Phase 2+, leave empty for local-only mode)
# TEAM_SYNC_ENABLED=false
# VIBEGUARD_TEAM_URL=

# Sentry error tracking (optional)
# SENTRY_DSN=
