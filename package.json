{
  "name": "vibeguard",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "db:migrate": "dbmate -d ./apps/vgx/db/migrations up",
    "db:rollback": "dbmate -d ./apps/vgx/db/migrations rollback",
    "db:status": "dbmate -d ./apps/vgx/db/migrations status",
    "docker:up": "podman compose -f docker/docker-compose.yml up -d",
    "docker:down": "podman compose -f docker/docker-compose.yml down",
    "docker:dev": "podman compose -f docker/docker-compose.yml -f docker/docker-compose.dev.yml up"
  },
  "devDependencies": {
    "turbo": "^2.3"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  }
}
